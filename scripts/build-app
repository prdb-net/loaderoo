#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
swift build -c release --product Loaderoo
products=$(swift build -c release --show-bin-path)
output=${1:-dist}
mkdir -p "$output"
stage=$(mktemp -d "$output/.loaderoo-build.XXXXXX")
trap 'rm -rf "$stage"' EXIT
app="$stage/Loaderoo.app"
contents="$app/Contents"
mkdir -p "$contents/MacOS" "$contents/Resources"
cp Packaging/Info.plist "$contents/"
cp Packaging/Loaderoo.icns "$contents/Resources/"
cp "$products/Loaderoo" "$contents/MacOS/"
for bundle in "$products"/*.bundle; do
    ditto "$bundle" "$contents/Resources/$(basename "$bundle")"
done
if [ -n "${CODE_SIGN_IDENTITY:-}" ]; then
    codesign --force --options runtime --timestamp --sign "$CODE_SIGN_IDENTITY" "$app"
else
    codesign --force --sign - "$app"
fi
codesign --verify --strict "$app"
target="$output/Loaderoo.app"
if [ -d "$target" ]; then
    # Swap complete bundles so a running executable is never overwritten in place.
    swift -e 'import Darwin
        if renamex_np(CommandLine.arguments[1], CommandLine.arguments[2], UInt32(RENAME_SWAP)) != 0 {
            perror("Could not replace Loaderoo.app")
            exit(1)
        }' "$app" "$target"
else
    mv "$app" "$target"
fi
echo "Built $target"
