#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
sdk_path=$(xcrun --sdk macosx --show-sdk-path)
sdk_version=$(xcrun --sdk macosx --show-sdk-version)
minimum_version=$(plutil -extract LSMinimumSystemVersion raw Packaging/Info.plist)
# SwiftPM can stamp the deployment target as the linked SDK. AppKit uses the
# linked SDK to select the appearance of native controls.
swift build -c release --product Loaderoo --sdk "$sdk_path" \
    -Xlinker -platform_version -Xlinker macos -Xlinker "$minimum_version" -Xlinker "$sdk_version"
products=$(swift build -c release --show-bin-path)
output=${1:-dist}
mkdir -p "$output"
stage=$(mktemp -d "$output/.loaderoo-build.XXXXXX")
trap 'rm -rf "$stage"' EXIT
app="$stage/Loaderoo.app"
contents="$app/Contents"
mkdir -p "$contents/MacOS" "$contents/Resources"
cp Packaging/Info.plist "$contents/"
cp Packaging/Loaderoo.icns "$contents/Resources/"
cp "$products/Loaderoo" "$contents/MacOS/"
versions=$(xcrun vtool -show-build "$contents/MacOS/Loaderoo")
if ! printf '%s\n' "$versions" | awk -v sdk="$sdk_version" -v min="$minimum_version" '
    $1 == "minos" { minimum_matches = ($2 == min) }
    $1 == "sdk" { sdk_matches = ($2 == sdk) }
    END { exit !(minimum_matches && sdk_matches) }
'; then
    printf 'Expected macOS %s minimum and SDK %s in Loaderoo:\n%s\n' "$minimum_version" "$sdk_version" "$versions" >&2
    exit 1
fi
for bundle in "$products"/*.bundle; do
    ditto "$bundle" "$contents/Resources/$(basename "$bundle")"
done
if [ -n "${CODE_SIGN_IDENTITY:-}" ]; then
    codesign --force --options runtime --timestamp --sign "$CODE_SIGN_IDENTITY" "$app"
else
    codesign --force --sign - "$app"
fi
codesign --verify --strict "$app"
target="$output/Loaderoo.app"
if [ -d "$target" ]; then
    # Swap complete bundles so a running executable is never overwritten in place.
    swift -e 'import Darwin
        if renamex_np(CommandLine.arguments[1], CommandLine.arguments[2], UInt32(RENAME_SWAP)) != 0 {
            perror("Could not replace Loaderoo.app")
            exit(1)
        }' "$app" "$target"
else
    mv "$app" "$target"
fi
echo "Built $target"
